# Required in production: 32+ random bytes, e.g. `openssl rand -base64 32`.
# Used to sign the HttpOnly cookie that unlocks password-protected content.
GATE_SECRET=

# Upstash Redis, provisioned through the Vercel Marketplace integration. Use
# either naming pair the integration injects; the UPSTASH_* names win when
# both are present. `KV_URL`/`REDIS_URL` are TCP and do not work here, and the
# read-only token cannot run the limiter's Lua script.
# Without these the rate limiter fails open and warns in the logs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: origin serving public content assets, e.g. a Cloudflare R2 bucket on
# a custom domain. Empty means "serve them from this site". Gated media is never
# affected — it always stays on /vault.
NEXT_PUBLIC_MEDIA_ORIGIN=
