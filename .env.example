# Required in production: 32+ random bytes, e.g. `openssl rand -base64 32`.
# Used to sign the HttpOnly cookie that unlocks password-protected content.
GATE_SECRET=

# Upstash Redis, provisioned through the Vercel Marketplace integration. Both
# names are what the integration writes and what `Redis.fromEnv()` expects.
# Without them the rate limiter fails open, so set them in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: origin serving public content assets, e.g. a Cloudflare R2 bucket on
# a custom domain. Empty means "serve them from this site". Gated media is never
# affected — it always stays on /vault.
NEXT_PUBLIC_MEDIA_ORIGIN=
